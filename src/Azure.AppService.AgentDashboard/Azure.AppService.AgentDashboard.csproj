<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Azure.AppService.AgentDashboard</PackageId>
    <Version>1.0.0</Version>
    <Authors>Microsoft</Authors>
    <Description>An agent observability dashboard for .NET App Service agent applications. Captures LLM call telemetry via IChatClient middleware and serves an embedded web dashboard.</Description>
    <PackageTags>azure;appservice;agents;dashboard;telemetry;ichatclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\dashboard.html" />
  </ItemGroup>

</Project>
