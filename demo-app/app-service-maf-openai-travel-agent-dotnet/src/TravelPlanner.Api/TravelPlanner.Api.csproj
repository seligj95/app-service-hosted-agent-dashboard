<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cf7a8e53-a42b-416d-98b8-b38b88b4f895</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.8" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.48.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravelPlanner.Shared\TravelPlanner.Shared.csproj" />
    <ProjectReference Include="..\..\..\..\src\Azure.AppService.AgentDashboard\Azure.AppService.AgentDashboard.csproj" />
  </ItemGroup>

  <!-- Publish WebJob into app_data/Jobs/Continuous/ so it deploys alongside the API -->
  <Target Name="PublishWebJob" AfterTargets="Publish">
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../TravelPlanner.WebJob/TravelPlanner.WebJob.csproj -c $(Configuration) -o $(PublishDir)app_data/Jobs/Continuous/TravelPlanWorker" />
  </Target>

</Project>
